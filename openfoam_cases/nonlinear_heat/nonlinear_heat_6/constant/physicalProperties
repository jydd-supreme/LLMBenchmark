FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      physicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       polynomialSolid;
    thermo          eConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleInternalEnergy;
}

mixture
{
    specie
    {
        molWeight       50;
    }
    equationOfState
    {
        rho             4500;
    }
    thermodynamics
    {
        hf              0;
        Cv              650;
    }
    transport
    {
        kappaCoeffs<8>  (10 -0.015 3e-05 0 0 0 0 0);
    }
}
