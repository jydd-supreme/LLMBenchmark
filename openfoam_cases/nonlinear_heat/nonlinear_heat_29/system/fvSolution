FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    e
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-10;
        relTol          0;
    }
    eFinal
    {
        $e;
    }
}

PIMPLE
{
    nOuterCorrectors         4;
    nCorrectors              1;
    nNonOrthogonalCorrectors 0;
}

relaxationFactors
{
    equations
    {
        e 0.9;
    }
}
