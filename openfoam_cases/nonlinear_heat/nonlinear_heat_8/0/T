FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [temperature];

internalField   uniform 450;

boundaryField
{
    hot
    {
        type fixedValue;
        value uniform 700;
    }
    cold
    {
        type fixedValue;
        value uniform 320;
    }
    insulated
    {
        type zeroGradient;
    }
    frontAndBack
    {
        type empty;
    }
}
