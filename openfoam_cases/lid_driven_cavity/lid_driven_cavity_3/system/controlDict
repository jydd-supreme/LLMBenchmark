FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

solver          fluid;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1;
deltaT          0.005;
writeControl    runTime;
writeInterval   0.1;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable false;
adjustTimeStep  no;
maxCo           0.3;
maxDeltaT       0.005;

functions
{
    probes
    {
        type                probes;
        libs                ("libsampling.so");
        writeControl        runTime;
        writeInterval       0.05;
        fields              (U p);
        fixedLocations      true;
        interpolationScheme cellPoint;
        probeLocations
        (
            (0.0075 0.0225 0.005)
            (0.0275 0.0325 0.005)
            (0.0525 0.0325 0.005)
            (0.0925 0.0275 0.005)
            (0.0225 0.0625 0.005)
            (0.0275 0.0475 0.005)
            (0.0575 0.0425 0.005)
            (0.0975 0.0425 0.005)
            (0.0075 0.0875 0.005)
            (0.0375 0.0925 0.005)
            (0.0675 0.0975 0.005)
            (0.0875 0.0875 0.005)
        );
    }
}
