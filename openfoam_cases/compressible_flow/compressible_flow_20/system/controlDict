FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          shockFluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2e-05;

deltaT          1e-10;

writeControl    adjustableRunTime;

writeInterval   5e-06;

cycleWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

adjustTimeStep  yes;

maxCo           0.2;

maxDeltaT       1;

functions
{

benchmarkProbes
{
    type                probes;
    libs                (sampling);
    writeControl        writeTime;
    interpolationScheme cellPoint;
    fields              (rho U p T);
    probeLocations
    (
            (0.002 0.001 0)
            (0.005 0.001 0)
            (0.01 0.001 0)
            (0.015 0.001 0)
            (0.02 0.001 0)
            (0.025 0.001 0)
            (0.005 0.004 0)
            (0.01 0.004 0)
            (0.015 0.004 0)
            (0.02 0.004 0)
            (0.025 0.004 0)
            (0.01 0.008 0)
            (0.02 0.008 0)
    );
}
}

