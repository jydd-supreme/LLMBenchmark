FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          shockFluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.2;

deltaT          5e-05;

writeControl    adjustableRunTime;

writeInterval   0.04;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  no;

maxCo           0.2;

maxDeltaT       1e-06;

functions
{

benchmarkProbes
{
    type                probes;
    libs                (sampling);
    writeControl        writeTime;
    interpolationScheme cellPoint;
    fields              (rho U p T);
    probeLocations
    (
            (-0.1 0.03 0)
            (-0.05 0.1 0)
            (0.03 0.03 0)
            (0.03 0.1 0)
            (0.1 0.06 0)
            (0.1 0.12 0)
            (0.2 0.1 0)
            (0.2 0.13 0)
            (0.28 0.125 0)
            (0.28 0.145 0)
    );
}
}

