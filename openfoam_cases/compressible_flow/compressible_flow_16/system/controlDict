FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          shockFluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         2e-05;

deltaT          1e-08;

writeControl    adjustableRunTime;

writeInterval   5e-06;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.2;

maxDeltaT       1;

functions
{

benchmarkProbes
{
    type                probes;
    libs                (sampling);
    writeControl        writeTime;
    interpolationScheme cellPoint;
    fields              (rho U p T);
    probeLocations
    (
            (-0.0072 0.0015 0)
            (-0.0065 0.0012 0)
            (-0.0055 0.0015 0)
            (-0.0045 0.0018 0)
            (-0.003 0.0022 0)
            (-0.002 0.0022 0)
            (-0.001 0.0022 0)
            (-0.006 0.0023 0)
    );
}
}

