FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultValues
{
    U       (35 0 0);
    T       360;
    p       150000;
}

zones
{
    lowPressure
    {
        type        box;

        box         (0.0 -1 -1) (5 1 1);

        values
        {
            U       (-15 0 0);
            T       290;
            p       20000;
        }
    }
}

