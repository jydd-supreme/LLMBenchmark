FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver          shockFluid;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         1;

deltaT          0.002;

writeControl    adjustableRunTime;

writeInterval   0.2;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           0.2;

maxDeltaT       1;

functions
{

benchmarkProbes
{
    type                probes;
    libs                (sampling);
    writeControl        writeTime;
    interpolationScheme cellPoint;
    fields              (rho U p T);
    probeLocations
    (
            (0.2 0.1 0)
            (0.2 0.5 0)
            (0.55 0.1 0)
            (0.55 0.7 0)
            (0.75 0.35 0)
            (0.75 0.7 0)
            (1.2 0.35 0)
            (1.2 0.7 0)
            (1.8 0.35 0)
            (1.8 0.7 0)
            (2.6 0.35 0)
            (2.6 0.7 0)
    );
}
}

