FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultValues
{
    U       (80 0 0);
    T       320;
    p       90000;
}

zones
{
    lowPressure
    {
        type        box;

        box         (-0.5 -1 -1) (5 1 1);

        values
        {
            U       (0 0 0);
            T       260;
            p       12000;
        }
    }
}

