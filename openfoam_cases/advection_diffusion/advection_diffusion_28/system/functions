FoamFile { format ascii; class dictionary; object functions; }
scalarTransportC
{
    type scalarTransport;
    libs ("libsolverFunctionObjects.so");
    field C;
    diffusivity viscosity;
    alphal 1.5;
    alphat 1.5;
    executeControl timeStep;
    executeInterval 1;
    writeControl writeTime;
}

benchmarkProbes
{
    type probes;
    libs ("libsampling.so");
    fields (C);
    interpolationScheme cell;
    fixedLocations true;
    executeControl timeStep;
    executeInterval 20;
    writeControl timeStep;
    writeInterval 20;
    writePrecision 12;
    probeLocations
    (
        (0.125 1.125 -1.5)
        (0.125 1.525 -1.5)
        (0.125 1.875 -1.5)
        (0.375 1.125 -1.5)
        (0.375 1.525 -1.5)
        (0.375 1.875 -1.5)
        (0.725 1.525 -1.5)
        (1.125 1.525 -1.5)
        (1.525 1.525 -1.5)
        (0.125 2.025 -1.5)
        (0.725 2.025 -1.5)
        (2.525 2.925 -1.5)
    );
}
