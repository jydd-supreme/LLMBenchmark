FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

solver          incompressibleFluid;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         4;
deltaT          0.005;
writeControl    runTime;
writeInterval   0.5;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable false;
adjustTimeStep  no;

functions
{
    scalarEvolution
    {
        type scalarTransport;
        libs ("libsolverFunctionObjects.so");
        field C;
        diffusivity constant;
        D 0.0001;
        nCorrectors 1;
    }
    probes
    {
        type probes;
        libs ("libsampling.so");
        writeControl writeTime;
        fields (C);
        fixedLocations true;
        interpolationScheme cellPoint;
        probeLocations
        (
            (0.0025 0.0875 0.005)
            (0.0225 0.0775 0.005)
            (0.0675 0.0675 0.005)
            (0.195 0.0725 0.005)
            (0.505 0.0475 0.005)
            (0.865 0.0175 0.005)
            (0.855 0.0325 0.005)
            (0.485 0.0125 0.005)
            (0.855 0.0075 0.005)
            (0.125 0.0025 0.005)
            (0.685 0.0725 0.005)
            (0.245 0.0125 0.005)
            (0.765 0.0225 0.005)
            (0.465 0.0325 0.005)
            (0.125 0.0675 0.005)
        );
    }
}
