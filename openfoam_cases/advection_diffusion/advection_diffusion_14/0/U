FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}

dimensions      [0 1 -1 0 0 0 0];
internalField   uniform (0.24 0 0);
boundaryField
{
    inlet
    {
        type uniformFixedValue;
        uniformValue {
            type table;
            values
            (
                (0 (0.24 0 0))
                (0.5 (0.4 0 0))
                (1 (0.293333333333 0 0))
                (2 (0.186666666667 0 0))
                (3 (0.373333333333 0 0))
                (4 (0.266666666667 0 0))
            );
        }
    }
    outlet { type zeroGradient; }
    walls { type noSlip; }
    frontAndBack { type empty; }
}
