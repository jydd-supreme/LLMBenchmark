FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.02;

deltaT          5e-06;

writeControl    runTime;

writeInterval   0.001;

purgeWrite      0;

writeFormat     ascii;

writePrecision  12;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;


functions
{
    benchmarkProbes
    {
        type                probes;
        libs                ("libsampling.so");
        executeControl      timeStep;
        executeInterval     1;
        writeControl        runTime;
        writeInterval       0.001;
        interpolationScheme cellPoint;
        fields              (phi);
        probeLocations
        (
            (0.000848528137 0.000848528137 0.25)
            (0.001060660172 0.001060660172 0.25)
            (0.001414213562 0.001414213562 0.25)
            (0.002121320344 0.002121320344 0.25)
            (0.003535533906 0.003535533906 0.25)
            (0.007071067812 0.007071067812 0.25)
            (0.014142135624 0.014142135624 0.25)
            (0.028284271247 0.028284271247 0.25)
            (0.049497474683 0.049497474683 0.25)
            (0.00984807753 0.001736481777 0.25)
            (0.00906307787 0.004226182617 0.25)
            (0.004226182617 0.00906307787 0.25)
            (0.001736481777 0.00984807753 0.25)
        );
    }
}

